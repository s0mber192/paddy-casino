# Токен бота от @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
HOST=0.0.0.0

# Откуда разрешены запросы (URL фронтенда, без слеша в конце)
CORS_ORIGIN=https://your-frontend.example.com

DB_PATH=./data/casino.db

# Серверные константы игры
COINS_PER_CLICK=1
MIN_CLICK_INTERVAL_MS=50
# Максимальный возраст initData в секундах (защита от replay)
INIT_DATA_MAX_AGE_SEC=86400